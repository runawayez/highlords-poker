{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "highlords-poker",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "PokerRoom" },
      { "name": "LOBBY", "class_name": "Lobby" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PokerRoom", "Lobby"] }],
  "observability": { "enabled": false },
}
