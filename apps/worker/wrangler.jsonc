{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "highlords-poker-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  "vars": { "ALLOWED_ORIGINS": "http://localhost:5173", "MAX_ROOMS": "30", "MAINTENANCE": "false" },
  "durable_objects": { "bindings": [{ "name": "POKER", "class_name": "PokerCoordinator" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PokerCoordinator"] }],
  "observability": { "enabled": false },
}
